{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fhirbridge-bench.org/schema/analysis_preregistration.schema.json",
  "title": "FHIRBridge Confirmatory Analysis Preregistration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_id",
    "status",
    "created_at",
    "sealed_set_opened",
    "frozen_inputs",
    "primary_estimand",
    "paired_comparisons",
    "multiplicity",
    "bootstrap",
    "mcnemar",
    "companion_estimand"
  ],
  "properties": {
    "schema_version": {
      "const": "0.4.0"
    },
    "analysis_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "incomplete_template",
        "preregistered"
      ]
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "sealed_set_opened": {
      "const": false
    },
    "frozen_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_commit",
        "projectability_contract_sha256",
        "structural_validity_policy_sha256",
        "statistical_analysis_plan_sha256",
        "model_prompt_configuration_sha256",
        "sample_size_preregistration_sha256"
      ],
      "properties": {
        "repository_commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{7,40}$"
        },
        "projectability_contract_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "structural_validity_policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "statistical_analysis_plan_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "model_prompt_configuration_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sample_size_preregistration_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "primary_estimand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "direction",
        "structural_condition",
        "semantic_condition"
      ],
      "properties": {
        "name": {
          "const": "VUR"
        },
        "direction": {
          "const": "FHIR_to_HL7v2"
        },
        "structural_condition": {
          "const": "VALID"
        },
        "semantic_condition": {
          "const": "determinate_FAITHFUL_or_UNFAITHFUL"
        }
      }
    },
    "paired_comparisons": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analysis_set_rule",
        "cluster_id_field",
        "model_keys",
        "comparison_family"
      ],
      "properties": {
        "analysis_set_rule": {
          "const": "both_arms_VALID_and_semantic_determinate_for_VUR"
        },
        "cluster_id_field": {
          "type": "string",
          "minLength": 1
        },
        "comparison_family": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "comparison_id",
              "model_key",
              "arm_a",
              "arm_b"
            ],
            "properties": {
              "comparison_id": {
                "type": "string",
                "minLength": 1
              },
              "arm_a": {
                "type": "string",
                "minLength": 1
              },
              "arm_b": {
                "type": "string",
                "minLength": 1
              },
              "model_key": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "model_keys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "multiplicity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "secondary_pairwise_method",
        "comparison_family_size"
      ],
      "properties": {
        "secondary_pairwise_method": {
          "const": "Holm"
        },
        "comparison_family_size": {
          "type": "integer",
          "minimum": 6
        }
      }
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "iterations",
        "seed",
        "confidence_level"
      ],
      "properties": {
        "method": {
          "const": "paired_cluster_percentile"
        },
        "iterations": {
          "const": 10000
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "confidence_level": {
          "const": 0.95
        }
      }
    },
    "mcnemar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "sidedness",
        "scope"
      ],
      "properties": {
        "method": {
          "const": "exact_binomial"
        },
        "sidedness": {
          "const": "two_sided"
        },
        "scope": {
          "const": "model_specific_only"
        }
      }
    },
    "companion_estimand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "denominator"
      ],
      "properties": {
        "name": {
          "const": "VFY"
        },
        "denominator": {
          "const": "all_attempted_transformations"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    }
  }
}

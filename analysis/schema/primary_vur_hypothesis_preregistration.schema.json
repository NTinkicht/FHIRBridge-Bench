{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fhirbridge-bench.org/schema/primary_vur_hypothesis_preregistration.schema.json",
  "title": "FHIRBridge Primary VUR Hypothesis Preregistration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "status",
    "created_at",
    "sealed_set_opened",
    "pilot_evidence",
    "estimand",
    "hypothesis",
    "target_population",
    "inference",
    "indeterminate_policy"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "record_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["incomplete_template", "preregistered"]},
    "created_at": {"type": ["string", "null"], "format": "date-time"},
    "sealed_set_opened": {"const": false},
    "pilot_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pilot_case_manifest_sha256",
        "pilot_analysis_sha256"
      ],
      "properties": {
        "pilot_case_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "pilot_analysis_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "estimand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "direction", "denominator_rule"],
      "properties": {
        "name": {"const": "VUR"},
        "direction": {"const": "FHIR_to_HL7v2"},
        "denominator_rule": {
          "const": "VALID_and_semantic_determinate"
        }
      }
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "null_relation",
        "alternative_relation",
        "nontrivial_vur_threshold",
        "threshold_rationale"
      ],
      "properties": {
        "null_relation": {"const": "VUR_less_than_or_equal_threshold"},
        "alternative_relation": {"const": "VUR_greater_than_threshold"},
        "nontrivial_vur_threshold": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "threshold_rationale": {"type": "string", "minLength": 1}
      }
    },
    "target_population": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inclusion_rule",
        "model_strategy_aggregation_policy",
        "cluster_id_field"
      ],
      "properties": {
        "inclusion_rule": {"type": "string", "minLength": 1},
        "model_strategy_aggregation_policy": {
          "type": "string",
          "minLength": 1
        },
        "cluster_id_field": {"const": "analysis_cluster_id"}
      }
    },
    "inference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "alpha",
        "sidedness",
        "cluster_handling",
        "confidence_interval_method",
        "decision_rule"
      ],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "alpha": {"const": 0.05},
        "sidedness": {"const": "one_sided"},
        "cluster_handling": {"type": "string", "minLength": 1},
        "confidence_interval_method": {"type": "string", "minLength": 1},
        "decision_rule": {"type": "string", "minLength": 1}
      }
    },
    "indeterminate_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_indeterminate_policy",
        "structural_policy_ref"
      ],
      "properties": {
        "semantic_indeterminate_policy": {
          "const": "exclude_from_binary_VUR_with_reported_denominator_loss_and_sensitivity_bounds"
        },
        "structural_policy_ref": {
          "const": "benchmark/structural_validity_policy.yaml"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    }
  }
}

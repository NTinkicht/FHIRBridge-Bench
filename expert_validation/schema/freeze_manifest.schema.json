{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fhirbridge-bench.org/schema/freeze_manifest.schema.json",
  "title": "FHIRBridge Instrument and Sealed-Set Freeze Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "manifest_id",
    "freeze_timestamp",
    "protocol_version",
    "repository_commit",
    "freeze_complete",
    "instrument_components",
    "dependencies",
    "reviewer_roster",
    "sealed_set",
    "blinding",
    "post_freeze_amendments"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.2.0"
    },
    "manifest_id": {
      "type": "string",
      "minLength": 1
    },
    "freeze_timestamp": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "protocol_version": {
      "type": "string",
      "minLength": 1
    },
    "repository_commit": {
      "$ref": "#/$defs/gitCommit"
    },
    "freeze_complete": {
      "type": "boolean",
      "description": "May be true only after all frozen artifacts, dependencies, and the sealed-set bundle are finalized."
    },
    "instrument_components": {
      "type": "object",
      "required": [
        "projectability_contract",
        "verifier",
        "fhir_lifter",
        "hl7v2_lifter",
        "canonical_schema",
        "severity_policy",
        "precedence_policy"
      ],
      "properties": {
        "projectability_contract": {
          "$ref": "#/$defs/frozenArtifact"
        },
        "verifier": {
          "$ref": "#/$defs/frozenArtifact"
        },
        "fhir_lifter": {
          "$ref": "#/$defs/frozenArtifact"
        },
        "hl7v2_lifter": {
          "$ref": "#/$defs/frozenArtifact"
        },
        "canonical_schema": {
          "$ref": "#/$defs/frozenArtifact"
        },
        "severity_policy": {
          "$ref": "#/$defs/frozenArtifact"
        },
        "precedence_policy": {
          "$ref": "#/$defs/frozenArtifact"
        }
      },
      "additionalProperties": false
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency"
      },
      "description": "Pinned terminology, UCUM, structural/profile validators, and other measurement-critical dependencies."
    },
    "sealed_set": {
      "type": "object",
      "required": [
        "split",
        "bundle_id",
        "bundle_sha256",
        "case_count",
        "case_manifest_sha256",
        "opened",
        "opened_at",
        "opened_by_role_ids"
      ],
      "properties": {
        "split": {
          "type": "string",
          "enum": [
            "development",
            "calibration",
            "sealed_test"
          ]
        },
        "bundle_id": {
          "type": "string",
          "minLength": 1
        },
        "bundle_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "case_count": {
          "type": "integer",
          "minimum": 0
        },
        "case_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "opened": {
          "type": "boolean"
        },
        "opened_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "opened_by_role_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "sampling_notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "enrichment_or_weighting_plan_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "blinding": {
      "type": "object",
      "required": [
        "role_ids",
        "model_identity_hidden",
        "generation_strategy_hidden",
        "verifier_verdict_hidden",
        "claimed_provenance_hidden",
        "other_reviewer_labels_hidden",
        "controls_verified"
      ],
      "properties": {
        "role_ids": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "role_id",
              "role"
            ],
            "properties": {
              "role_id": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string",
                "enum": [
                  "primary_reviewer_interoperability",
                  "primary_reviewer_clinical_informatics",
                  "adjudicator",
                  "data_custodian",
                  "analysis_custodian"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "model_identity_hidden": {
          "type": "boolean"
        },
        "generation_strategy_hidden": {
          "type": "boolean"
        },
        "verifier_verdict_hidden": {
          "type": "boolean"
        },
        "claimed_provenance_hidden": {
          "type": "boolean"
        },
        "other_reviewer_labels_hidden": {
          "type": "boolean"
        },
        "controls_verified": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "acceptance_gate": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "preregistration_ref": {
          "type": "string",
          "minLength": 1
        },
        "preregistration_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "defined_before_sealed_opening": {
          "type": "boolean"
        },
        "gate_policy_summary": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "preregistration_ref",
        "preregistration_sha256",
        "defined_before_sealed_opening",
        "gate_policy_summary"
      ],
      "additionalProperties": false
    },
    "post_freeze_amendments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "amendment_id",
          "timestamp",
          "reason",
          "affected_components",
          "sealed_set_had_been_opened",
          "fresh_sealed_set_required",
          "disposition"
        ],
        "properties": {
          "amendment_id": {
            "type": "string",
            "minLength": 1
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "affected_components": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "sealed_set_had_been_opened": {
            "type": "boolean"
          },
          "fresh_sealed_set_required": {
            "type": "boolean"
          },
          "replacement_manifest_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "disposition": {
            "type": "string",
            "enum": [
              "NO_EFFECT_ON_FROZEN_MEASUREMENT",
              "REQUIRES_NEW_SEALED_SET",
              "DOWNGRADE_TO_EXPLORATORY"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "reviewer_roster": {
      "$ref": "#/$defs/frozenArtifact"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{7,40}$"
    },
    "frozenArtifact": {
      "type": "object",
      "required": [
        "artifact_id",
        "version",
        "path_or_ref",
        "sha256"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "path_or_ref": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "dependency": {
      "type": "object",
      "required": [
        "name",
        "version",
        "purpose",
        "source_or_ref"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "enum": [
            "terminology",
            "ucum",
            "fhir_validation",
            "hl7v2_validation",
            "parsing",
            "statistics",
            "other"
          ]
        },
        "source_or_ref": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

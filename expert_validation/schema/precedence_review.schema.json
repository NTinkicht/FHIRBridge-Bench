{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fhirbridge-bench.org/schema/precedence_review.schema.json",
  "title": "FHIRBridge Semantic Error Precedence Review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "status",
    "created_at",
    "candidate_policy_sha256",
    "blind_stage_evidence",
    "reviewers",
    "independent_decisions",
    "adjudication",
    "attestation"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "review_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "incomplete_template",
        "completed"
      ]
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "candidate_policy_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "reviewers": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/reviewer"
      }
    },
    "independent_decisions": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/decision"
      }
    },
    "adjudication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "rationale"
      ],
      "properties": {
        "decision": {
          "enum": [
            "ACCEPT",
            "REJECT",
            "INDETERMINATE"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "independent_initial_decisions",
        "other_reviewer_decisions_hidden_initially",
        "sealed_cases_used",
        "candidate_order_not_changed_during_adjudication"
      ],
      "properties": {
        "independent_initial_decisions": {
          "const": true
        },
        "other_reviewer_decisions_hidden_initially": {
          "const": true
        },
        "sealed_cases_used": {
          "const": false
        },
        "candidate_order_not_changed_during_adjudication": {
          "const": true
        }
      }
    },
    "blind_stage_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assignment_id",
        "reviewer_a_response_sha256",
        "reviewer_b_response_sha256",
        "original_responses_retained",
        "other_reviewer_decisions_hidden_initially"
      ],
      "properties": {
        "assignment_id": {
          "const": "FHIRBRIDGE-PRECEDENCE-BLIND-001"
        },
        "reviewer_a_response_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "reviewer_b_response_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "original_responses_retained": {
          "const": true
        },
        "other_reviewer_decisions_hidden_initially": {
          "const": true
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_id",
        "expertise",
        "conflicts_of_interest",
        "prior_project_involvement"
      ],
      "properties": {
        "reviewer_id": {
          "type": "string",
          "minLength": 1
        },
        "expertise": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "conflicts_of_interest": {
          "type": "string"
        },
        "prior_project_involvement": {
          "type": "string"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_id",
        "decision",
        "rationale"
      ],
      "properties": {
        "reviewer_id": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "enum": [
            "ACCEPT",
            "REJECT",
            "INDETERMINATE"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fhirbridge-bench.org/schema/severity_calibration.schema.json",
  "title": "FHIRBridge Semantic Severity Calibration Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "calibration_id",
    "status",
    "created_at",
    "candidate_policy_sha256",
    "blind_stage_evidence",
    "reviewers",
    "anchor_reviews",
    "pre_adjudication_agreement",
    "major_threshold_decision",
    "attestation"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "calibration_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "incomplete_template",
        "completed"
      ]
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "reviewers": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reviewer_id",
          "expertise",
          "conflicts_of_interest",
          "prior_project_involvement"
        ],
        "properties": {
          "reviewer_id": {
            "type": "string",
            "minLength": 1
          },
          "expertise": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "conflicts_of_interest": {
            "type": "string"
          },
          "prior_project_involvement": {
            "type": "string"
          }
        }
      }
    },
    "anchor_reviews": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/anchorReview"
      }
    },
    "pre_adjudication_agreement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchor_count",
        "exact_agreement_count",
        "exact_agreement_rate",
        "disagreement_anchor_ids"
      ],
      "properties": {
        "anchor_count": {
          "type": "integer",
          "minimum": 1
        },
        "exact_agreement_count": {
          "type": "integer",
          "minimum": 0
        },
        "exact_agreement_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "disagreement_anchor_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "major_threshold_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "threshold",
        "included_levels",
        "rationale",
        "decision_status"
      ],
      "properties": {
        "threshold": {
          "enum": [
            "S1_or_higher",
            "S2_or_higher",
            "S3_only"
          ]
        },
        "included_levels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "S1",
              "S2",
              "S3"
            ]
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "decision_status": {
          "const": "frozen_for_confirmatory_endpoint"
        }
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "independent_initial_ratings",
        "sealed_cases_used",
        "adjudication_after_initial_ratings",
        "all_disagreements_retained"
      ],
      "properties": {
        "independent_initial_ratings": {
          "const": true
        },
        "sealed_cases_used": {
          "const": false
        },
        "adjudication_after_initial_ratings": {
          "const": true
        },
        "all_disagreements_retained": {
          "const": true
        }
      }
    },
    "candidate_policy_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "blind_stage_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assignment_id",
        "reviewer_a_response_sha256",
        "reviewer_b_response_sha256",
        "original_responses_retained",
        "boundary_roles_hidden_initially"
      ],
      "properties": {
        "assignment_id": {
          "const": "FHIRBRIDGE-SEVERITY-BLIND-001"
        },
        "reviewer_a_response_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "reviewer_b_response_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "original_responses_retained": {
          "const": true
        },
        "boundary_roles_hidden_initially": {
          "const": true
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "rating": {
      "enum": [
        "S0",
        "S1",
        "S2",
        "S3",
        "INDETERMINATE"
      ]
    },
    "anchorReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchor_id",
        "anchor_description",
        "expected_boundary_role",
        "reviewer_ratings",
        "adjudicated_severity",
        "adjudication_rationale"
      ],
      "properties": {
        "anchor_id": {
          "type": "string",
          "minLength": 1
        },
        "anchor_description": {
          "type": "string",
          "minLength": 1
        },
        "expected_boundary_role": {
          "enum": [
            "S0_S1_boundary",
            "S1_S2_boundary",
            "S2_S3_boundary",
            "clear_S2_anchor",
            "clear_S3_anchor"
          ]
        },
        "reviewer_ratings": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reviewer_id",
              "severity",
              "rationale"
            ],
            "properties": {
              "reviewer_id": {
                "type": "string",
                "minLength": 1
              },
              "severity": {
                "$ref": "#/$defs/rating"
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "adjudicated_severity": {
          "$ref": "#/$defs/rating"
        },
        "adjudication_rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}

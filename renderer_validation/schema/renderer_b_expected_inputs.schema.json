{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fhirbridge-bench.org/schema/renderer_b_expected_inputs.schema.json",
  "title": "FHIRBridge Renderer B Clean-Room Expected Inputs",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "handoff_id",
    "created_at",
    "clean_room_inputs"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "handoff_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "clean_room_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_full_name",
        "branch",
        "starting_commit",
        "challenge_id",
        "challenge_version",
        "challenge_manifest_sha256",
        "contract_path",
        "contract_sha256"
      ],
      "properties": {
        "repository_full_name": {"const": "NTinkicht/FHIRBridge-Bench"},
        "branch": {"const": "renderer-b-cleanroom"},
        "starting_commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "challenge_id": {"const": "FHIRBRIDGE-RENDERER-B-DEV-001"},
        "challenge_version": {"const": "0.2.0"},
        "challenge_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "contract_path": {
          "const": "contracts/fhir_to_v2/lab_oru_r01_v0.3.yaml"
        },
        "contract_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        }
      }
    }
  }
}

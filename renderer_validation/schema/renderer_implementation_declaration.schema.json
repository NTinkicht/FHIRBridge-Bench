{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fhirbridge-bench.org/schema/renderer_implementation_declaration.schema.json",
  "title": "FHIRBridge Renderer Implementation Declaration",
  "type": "object",
  "required": [
    "schema_version",
    "renderer_id",
    "renderer_version",
    "contributor",
    "implementation",
    "contract",
    "standards_sources",
    "implementation_period",
    "independence",
    "known_unsupported_cases"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "renderer_id": {
      "type": "string",
      "minLength": 1
    },
    "renderer_version": {
      "type": "string",
      "minLength": 1
    },
    "contributor": {
      "type": "object",
      "required": ["identity", "role"],
      "properties": {
        "identity": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "organization": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "implementation": {
      "type": "object",
      "required": ["language", "major_libraries", "source_commit"],
      "properties": {
        "language": {"type": "string", "minLength": 1},
        "major_libraries": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{7,40}$"
        },
        "implementation_notes": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "contract": {
      "type": "object",
      "required": ["contract_id", "contract_version"],
      "properties": {
        "contract_id": {"type": "string", "minLength": 1},
        "contract_version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "standards_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "version_or_date"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "version_or_date": {"type": "string", "minLength": 1},
          "reference": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "implementation_period": {
      "type": "object",
      "required": ["started_on", "completed_on"],
      "properties": {
        "started_on": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "completed_on": {
          "type": ["string", "null"],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "additionalProperties": false
    },
    "independence": {
      "type": "object",
      "required": [
        "renderer_a_source_inspected_before_initial_commit",
        "renderer_a_outputs_inspected_before_initial_commit",
        "renderer_a_mapping_code_reused",
        "llm_generated_mapping_code_used",
        "shared_semantic_mapping_utility_used",
        "accidental_exposure",
        "declaration_complete"
      ],
      "properties": {
        "renderer_a_source_inspected_before_initial_commit": {"type": "boolean"},
        "renderer_a_outputs_inspected_before_initial_commit": {"type": "boolean"},
        "renderer_a_mapping_code_reused": {"type": "boolean"},
        "llm_generated_mapping_code_used": {"type": "boolean"},
        "shared_semantic_mapping_utility_used": {"type": "boolean"},
        "accidental_exposure": {"type": ["string", "null"]},
        "same_language_as_renderer_a_rationale": {"type": ["string", "null"]},
        "declaration_complete": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "terminology_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "version"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "known_unsupported_cases": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "signed_statement": {
      "type": ["string", "null"],
      "description": "Human-readable declaration; structured fields remain authoritative for audit checks."
    }
  },
  "additionalProperties": false
}

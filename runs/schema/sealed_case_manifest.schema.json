{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fhirbridge-bench.org/schema/sealed_case_manifest.schema.json",
  "title": "FHIRBridge Sealed Confirmatory Case Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "status",
    "created_at",
    "split",
    "case_count",
    "cases"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "manifest_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["incomplete_template", "sealed"]},
    "created_at": {"type": ["string", "null"], "format": "date-time"},
    "split": {"const": "sealed_test"},
    "case_count": {"type": "integer", "minimum": 1},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "scenario_family",
        "source_input_sha256",
        "canonical_graph_sha256"
      ],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "scenario_family": {
          "type": "string",
          "pattern": "^LAB-[0-9]{3}$"
        },
        "source_input_sha256": {"$ref": "#/$defs/sha256"},
        "canonical_graph_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}

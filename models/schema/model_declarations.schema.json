{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fhirbridge-bench.org/schema/model_declarations.schema.json",
  "title": "FHIRBridge Confirmatory Model Declarations",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "models"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/model"}
    }
  },
  "$defs": {
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_key",
        "provider",
        "model_id",
        "model_revision_or_snapshot",
        "temperature",
        "top_p",
        "max_output_tokens",
        "seed_policy",
        "seed",
        "structured_output_mode"
      ],
      "properties": {
        "model_key": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "model_id": {"type": "string", "minLength": 1},
        "model_revision_or_snapshot": {"type": "string", "minLength": 1},
        "temperature": {"type": "number", "minimum": 0},
        "top_p": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "max_output_tokens": {"type": "integer", "minimum": 1},
        "seed_policy": {
          "enum": [
            "fixed_supported_seed",
            "provider_does_not_support_seed"
          ]
        },
        "seed": {"type": ["integer", "null"], "minimum": 0},
        "structured_output_mode": {"const": "plain_text_hl7_message"}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "seed_policy": {"const": "fixed_supported_seed"}
            }
          },
          "then": {
            "properties": {
              "seed": {"type": "integer", "minimum": 0}
            }
          }
        },
        {
          "if": {
            "properties": {
              "seed_policy": {
                "const": "provider_does_not_support_seed"
              }
            }
          },
          "then": {
            "properties": {
              "seed": {"type": "null"}
            }
          }
        }
      ]
    }
  }
}
